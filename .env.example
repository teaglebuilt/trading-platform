# Trading Platform Configuration

# Redis
REDIS_URL=redis://localhost:6379/0

# Alpaca Trading API (required for executor)
# Get keys from https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here
ALPACA_PAPER=true

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=

# Risk Settings
DAILY_LOSS_LIMIT_PCT=0.02
POSITION_SIZE_LIMIT_PCT=0.10
DRAWDOWN_ALERT_PCT=0.05

# Strategy Engine
ENABLE_RISK_PIPELINE=true
DEFAULT_CRYPTO_BACKEND=freqtrade
DEFAULT_EQUITY_BACKEND=backtrader

# External Adapters (optional)
FREQTRADE_BASE_URL=
JESSE_BASE_URL=

# Portfolio
DUCKDB_FILE=/data/portfolio.db

# Reporter
REPORT_INTERVAL_SECONDS=300
